# ---- Names follow the Vercel + Supabase + Clerk deployment guide ----
# Both NEXT_PUBLIC_* (guide) and VITE_* (legacy) prefixes are accepted.

# Clerk (Authentication) — from clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (Database) — from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Supabase Edge Functions, NEVER by the browser app:
SUPABASE_SERVICE_ROLE_KEY=

# Platform admin (auto-granted the admin role on first sign-in)
ADMIN_EMAIL=mwandabrands@gmail.com

# AI Reasoning & Learning Engine (stored in Supabase Edge Function secrets)
OPENAI_API_KEY=
